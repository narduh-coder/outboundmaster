UPDATE Staging.dbo.OutboundMaster 
	SET EstimatedDeliveryDate = CASE 
									WHEN DATEPART(WEEKDAY,Cast(DATEADD(HOUR, 72 + ISNULL(S.PFSShipToDeliverSLA,3) ,WaveCreatedDateTime) AS DATE)) = 1 THEN
										Cast(DATEADD(HOUR, 72 + ISNULL(S.PFSShipToDeliverSLA,3) + 24,WaveCreatedDateTime) AS DATE) --Sunday Delivery
									WHEN DATEPART(WEEKDAY,Cast(DATEADD(HOUR, 72 + ISNULL(S.PFSShipToDeliverSLA,3) ,WaveCreatedDateTime) AS DATE)) = 7 THEN
