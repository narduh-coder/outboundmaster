		WHEN S.ClickToShipHours-RT.ClickToShipHoursSLA <=0 THEN 'Y'
		ELSE 'N' 
	END
FROM Reporting.dbo.OutboundMaster S
	LEFT JOIN SQL2008.SCDBMaster.dbo.RoutingTypeCodes RT
		ON S.RoutingType = RT.RoutingTypeCode
WHERE Channel = 'DTC' AND ClickToShipException = 'N' AND ReCalc = 'Y'


--Set In SLA Flag Click To Deliver
UPDATE Reporting.dbo.OutboundMaster SET InSLA_ClickToDeliver = 
	CASE
		WHEN S.ClickToDeliverHours-RT.ClickToDeliverHoursSLA <=0 THEN 'Y'
		ELSE 'N'
	END
FROM Reporting.dbo.OutboundMaster S
	LEFT JOIN SQL2008.SCDBMaster.dbo.RoutingTypeCodes RT
		ON S.RoutingType = RT.RoutingTypeCode
WHERE Channel = 'DTC' AND ClickToDeliverException = 'N' AND ReCalc = 'Y'

EXECUTE ProcessLog.dbo.ProcessLogUpdate @ProcessID = @intProcessID, @Message = 'Complete: Update Metrics in Reporting (DTC)', @StartTime = @dtBeginDateTime, @RecordCount = @@ROWCOUNT

--****Retail Metrics****

SET @dtBeginDateTime = GETDATE()

--Wave To Ship 
UPDATE Reporting.dbo.OutboundMaster SET WaveToShipHours = DATEDIFF(HOUR,WaveCreatedDateTime,ShipDateTime)
WHERE Channel = 'Retail' AND WaveToShipException = 'N' AND ReCalc = 'Y'

--Ship To Deliver
UPDATE Reporting.dbo.OutboundMaster SET ShipToDeliverHours = DATEDIFF(HOUR,ShipDateTime,DeliveredDateTime)
WHERE Channel = 'Retail' AND ShipToDeliverException = 'N' AND ReCalc = 'Y'


--Wave To Deliver
UPDATE Reporting.dbo.OutboundMaster SET WaveToDeliverHours = DATEDIFF(HOUR,WaveCreatedDateTime,DeliveredDateTime)
WHERE Channel = 'Retail' AND WaveToDeliverException = 'N' AND ReCalc = 'Y'


--Deliver To Acknowledge
UPDATE Reporting.dbo.OutboundMaster SET DeliverToAcknowledgeHours = DATEDIFF(HOUR,DeliveredDateTime,AcknowledgeDateTime)
WHERE Channel = 'Retail' AND DeliverToAcknowedgeException = 'N' AND ReCalc = 'Y'


--Before/On/After EDD
UPDATE Reporting.dbo.OutboundMaster SET BeforeOnAfterEDD = ISNULL(
	CASE
		WHEN CAST(EstimatedDeliveryDate AS DATE) > CAST(DeliveredDateTime AS DATE) AND EDDException = 'N' AND ClickToDeliverException = 'N' THEN 'Before'
		WHEN CAST(EstimatedDeliveryDate AS DATE) = CAST(DeliveredDateTime AS DATE) AND EDDException = 'N' AND ClickToDeliverException = 'N' THEN 'On'
		WHEN CAST(EstimatedDeliveryDate AS DATE) < CAST(DeliveredDateTime AS DATE) AND EDDException = 'N' AND ClickToDeliverException = 'N' THEN 'After'
		ELSE 'Other'
	END, 'Other')
WHERE Channel = 'Retail' AND /*EDDException = 'N' AND*/ ReCalc = 'Y'


--On Time 
UPDATE Reporting.dbo.OutboundMaster SET OnTime = 
	CASE
		WHEN CAST(EstimatedDeliveryDate AS DATE) >= CAST(DeliveredDateTime AS DATE) AND EDDException = 'N' AND ClickToDeliverException = 'N' THEN 'Y'
		ELSE 'N'
	END
WHERE Channel = 'Retail' /*AND EDDException = 'N'*/ AND ReCalc = 'Y'


--Set In SLA Flag Click To Ship (RLS Only Until PFS is defined)
UPDATE Reporting.dbo.OutboundMaster SET InSLA_ClickToShip = 
	CASE
		WHEN S.WaveToShipHours-RT.ClickToShipHoursSLA <=0 THEN 'Y'
		ELSE 'N'
	END
FROM Reporting.dbo.OutboundMaster S
	LEFT JOIN SQL2008.SCDBMaster.dbo.RoutingTypeCodes RT
		ON S.RoutingType = RT.RoutingTypeCode
WHERE Channel = 'Retail' AND Division = 'RLS' AND WaveToShipException = 'N' AND ReCalc = 'Y'


--Set In SLA Flag Click To Ship (PFS Only Until RLS is defined)
UPDATE Reporting.dbo.OutboundMaster SET InSLA_ShipToDeliver = 
	CASE
		WHEN S.ShipToDeliverHours-RT.PFSShipToDeliverSLA <=0 THEN 'Y'
		ELSE 'N'
	END
FROM Reporting.dbo.OutboundMaster S
	LEFT JOIN SQL2008.SCDBMaster.dbo.States RT
		ON S.ShipToState = RT.StateCode
WHERE Channel = 'Retail' AND Division = 'PFS' AND ShipToDeliverException = 'N' AND ReCalc = 'Y'

