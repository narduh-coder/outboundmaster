
DECLARE @BeginDate AS int
DECLARE @EndDate AS int
DECLARE @FiscalBeginMinus1 AS int
DECLARE @dtBeginDateTime AS datetime
DECLARE @intProcessID AS int = 126

SELECT @BeginDate = PKMSDate
FROM MasterData.dbo.vFiscalCalendar
WHERE Date = CAST(DATEADD(day,-7,GETDATE()) AS DATE)
						
SELECT @EndDate = PKMSDate
FROM MasterData.dbo.vFiscalCalendar
WHERE Date = CAST(DATEADD(day,-1,GETDATE()) AS DATE)

SELECT @FiscalBeginMinus1 = CONVERT(varchar(8),CAST(DATEADD(day,-365,Date) AS DATE),112)
FROM MasterData.dbo.vFiscalCalendar
WHERE Date = CAST(DATEADD(day,-7,GETDATE()) AS DATE)

