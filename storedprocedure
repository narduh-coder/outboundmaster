--*********************************Update RedShift Dollars in Reporting*********************************


--Just in case SAP IMport failed when data was originally populated - ATysinger 2/23/2022

SET @dtBeginDateTime = GETDATE()

--Roll data up to the OrderNumber level for SAP Compare
IF OBJECT_ID('tempdb..#ShipDollars_Rollup2') IS NOT NULL DROP TABLE #ShipDollars_Rollup2;


SELECT DISTINCT Source,PlantCode,ControlNo,OrderNumber,UPC
INTO #ShipDollars_Rollup2
FROM Reporting.dbo.OutboundMaster
WHERE Source <> 'NLS' AND Channel <> 'DTC' AND ISNUMERIC(OrderNumber) = 1 AND (NetPriceSAP IS NULL OR NetPriceSAP = 0) --ATysinger 9/30/2022 Changed to add in'OR NetPriceSAP = 0'


--Pull SAP dollars
IF OBJECT_ID('tempdb..#ShipDollars_Rollup_Dollars2') IS NOT NULL DROP TABLE #ShipDollars_Rollup_Dollars2;


SELECT Source,PlantCode,ControlNo,OrderNumber,UPC,
		MAX(O.NET_PRICE) AS NET_PRICE
INTO #ShipDollars_Rollup_Dollars2
FROM #ShipDollars_Rollup2 S
	LEFT JOIN RedshiftData.dbo.fact_bookings_prepack_v O
		ON CAST(OrderNumber AS BIGINT) = O.SO_NUMBER AND S.UPC = O.EANUPC
WHERE O.SO_NUMBER IS NOT NULL AND O.NET_PRICE > 0
GROUP BY Source,PlantCode,ControlNo,OrderNumber,UPC


--Apply SAP dollars to main table
UPDATE Reporting.dbo.OutboundMaster SET NetPriceSAP = R.NET_PRICE, ReCalc = CASE WHEN ReCalc = 'N' THEN 'DN' ELSE 'DY' END 
FROM Reporting.dbo.OutboundMaster S
	INNER JOIN #ShipDollars_Rollup_Dollars2 R
		ON S.Source = R.Source AND S.PlantCode = R.PlantCode AND S.ControlNo = R.ControlNo AND S.OrderNumber = R.OrderNumber AND S.UPC = R.UPC
		
--Update Pack Dollars
UPDATE Reporting.dbo.OutboundMaster SET PackedDollars = NetPriceSAP * PackedUnits, ReCalc = CASE WHEN ReCalc = 'DY' THEN 'Y' ELSE 'N' END
FROM Reporting.dbo.OutboundMaster 
WHERE Channel = 'Wholesale' AND ReCalc IN ('DY','DN')

EXECUTE ProcessLog.dbo.ProcessLogUpdate @ProcessID = @intProcessID, @Message = 'Complete: Update RedShift Dollars in Reporting', @StartTime = @dtBeginDateTime, @RecordCount = @@ROWCOUNT

