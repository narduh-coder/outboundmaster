--Update Channel and Division
UPDATE Staging.dbo.OutboundMaster SET Channel = 
CASE 
	WHEN PlantCode IN ('501','502','507','562') THEN 'Wholesale'
	WHEN PlantCode = '566' AND OrderType = 'PF' THEN 'Retail' 
	WHEN PlantCode = '566' THEN 'Wholesale' 
	WHEN PlantCode = '001' THEN 'Retail'
	WHEN PlantCode = 'HPD' AND (PHSpecInstrCode2 = '81' OR OrderType = 'WH') THEN 'Wholesale'
	WHEN PlantCode = 'HPD' AND (PHSpecInstrCode2 = '71' OR OrderType = 'RL' OR PHSpecInstrCode2 = '82') THEN 'Retail'
	WHEN PlantCode = 'HPD' AND PHSpecInstrCode2 = '88' THEN 'DTC'
	WHEN PlantCode = 'HPD' THEN 'DTC'
	WHEN PlantCode = 'CAN' THEN 'DTC'
	WHEN PlantCode = 'I10' AND SeasonCode = '21' THEN 'Wholesale'
	ELSE 'Unknown'
END,
Division = 
CASE 
	WHEN PlantCode IN ('501','502','507','562') THEN 'Wholesale'
	WHEN PlantCode = '566' AND OrderType = 'PF' THEN 'PFS' 
	WHEN PlantCode = '566' AND SeasonCode = '31' THEN 'CM Wholesale' 
	WHEN PlantCode = '566' THEN 'Wholesale' 
	WHEN PlantCode = '001' AND SeasonCode = '01' THEN 'PFS'
	WHEN PlantCode = '001' AND SeasonCode = '02' THEN 'CMS'
	WHEN PlantCode = 'HPD' AND PHSpecInstrCode2 = '51' THEN 'RLE-US' 
	WHEN PlantCode = 'HPD' AND PHSpecInstrCode2 = '88' THEN 'RLE-CA'
	WHEN PlantCode = 'HPD' AND  PHSpecInstrCode2 = '53' THEN 'CME-US' 
	WHEN PlantCode = 'CAN' AND  PHSpecInstrCode2 = '54' THEN 'CME-CA' 
	WHEN PlantCode = 'HPD' AND  PHSpecInstrCode2 = '55' THEN 'CME-US' 
	WHEN PlantCode = 'CAN' AND  PHSpecInstrCode2 = '56' THEN 'CME-CA' 
	WHEN PlantCode = 'HPD' AND  PHSpecInstrCode2 = '57' THEN 'RLE-US' 
	WHEN PlantCode = 'HPD' AND PHSpecInstrCode2 = '82' THEN 'RLS-CA'
	WHEN PlantCode = 'HPD' AND  (PHSpecInstrCode2 = '71' OR OrderType = 'RL') THEN 'RLS' 
	WHEN PlantCode = 'HPD' AND  (PHSpecInstrCode2 = '81' OR OrderType = 'WH') THEN 'Wholesale'
	WHEN PlantCode = 'HPD' AND  SeasonCode = '51' THEN 'RLE-US'
	WHEN PlantCode = 'HPD' AND  SeasonCode = '53' THEN 'CME-US'
	WHEN PlantCode = 'HPD' AND PHSpecInstrCode2 = '88' THEN 'RLE-CA'
	WHEN PlantCode = 'I10' AND SeasonCode = '21' THEN 'Wholesale'
	ELSE 'Unknown'
END 

EXECUTE ProcessLog.dbo.ProcessLogUpdate @ProcessID = @intProcessID, @Message = 'Complete: Update Channel and Division', @StartTime = @dtBeginDateTime, @RecordCount = @@ROWCOUNT


