--Add in PickTicket Header Info (NLS)
UPDATE Staging.dbo.OutboundMaster SET OrderNumber = P.O1ORDN,PickTicketCreatedDateTime = MasterData.dbo.ConvertAS400DateTime(O1DCR,O1TCR),
											PlannedShipVia = P.O1SVIA, OrderType = P.O1OTYP, MajorMinorInd = P.O1MSPK, SoldTo = P.O1SOTO,
											ShipTo = P.O1SHTO, SoldToName = P.O1SHNM, PktNumber = P.O1PKTN,PHMisc11 = P.O1MS11, PHSpecInstrCode1 = P.O1SC1,
											PHSpecInstrCode2 = P.O1SC2,PHSpecInstrCode3 = P.O1SC3,PHSpecInstrCode5 = P.O1SC5,
											CustomerPO = P.O1CUPO,ShipToCity = P.O1SHCT, ShipToState = P.O1SHST, ShipToZip = P.O1SHZP, RefPktCtlNo = P.O1RFPN,
											StoreCode = P.O1STOR,HandlingCharges = P.O1HCHG,PHMisc9 = P.O1MIS9,ShiptoCountry = P.O1SHCN,
											PHSpecInstrCode4 = P.O1SC4, HostApointmentNumber = P.O1APPT,FreightTerms = P.O1CFRT
FROM Staging.dbo.OutboundMaster O
	INNER JOIN (SELECT A.* 
				FROM PkMSData.dbo.O1OPUT00 A
					INNER JOIN (SELECT O1.Source,O1.PlantCode,O1.O1PCTL,MIN(MasterData.dbo.ConvertAS400DateTime(O1.O1DCR,O1.O1TCR)) AS MinCreated
									FROM PkMSData.dbo.O1OPUT00 O1
										INNER JOIN (SELECT DISTINCT Source,Plantcode, ControlNo
													FROM Staging.dbo.OutboundMaster
													WHERE Source = 'NLS') O
											ON O1.Source = O.Source AND O1.PlantCode = O.PlantCode AND O1.O1PCTL = O.ControlNo
									WHERE O1.Source = 'NLS' 
									GROUP BY O1.Source,O1.PlantCode,O1.O1PCTL) B
						ON A.Source = B.Source AND A.PlantCode = B.PlantCode AND A.O1PCTL = B.O1PCTL AND
							MasterData.dbo.ConvertAS400DateTime(A.O1DCR,A.O1TCR) = B.MinCreated) P
		ON O.Source = P.Source AND O.PlantCode = P.PlantCode AND O.ControlNo = P.O1PCTL
WHERE O.Source = 'NLS' AND O1DCR >= @FiscalBeginMinus1

